// ============================================================================
// DigitalRoute MediationZone 9 — Ultra Data Format
// Format Name: ProductAPI.UFL_Product_API
// Description: UDR definitions for ProductAPI REST Agent, Aggregation, & SAP RFC
// ============================================================================

// 1. Aggregation Session UDR
session ProductSession {
    string dupValue;            // Aggregation Key (e.g., subscriberId + "_" + transactionId)
    int count;                  // Request Counter per sliding window
    string subscriberId;
    string path;
    date firstRequestTime;
    drudr activeRequestUdr;
};

// 2. Internal Aggregation & Duplicate Check Container UDR
internal DuplicateCheckInt {
    string errCode;             // "ERR_DUPLICATE_REQUEST" or ""
    string dupValue;            // Aggregation Key Signature
    int count;                  // Current session count
    drudr ResUDR;               // Holds the original REST Cycle UDR
    drudr cycleReqUDR;          // Extra Context UDR
};

// 3. HTTP REST Request UDR (Mapped from HTTP REST Server Agent)
internal Request {
    string clientHost;
    string httpMethod;          // POST, GET, OPTIONS
    list<string> pathParams;    // e.g. ["search"], ["simulate"], ["currentSubscription"]
    string authentication;
    bytearray body;             // Raw JSON payload bytes
};

// 4. HTTP REST Response UDR (Sent back to REST Server Agent)
internal Response {
    int httpResponseCode;       // 200, 400, 401, 404, 409, 500
    map<string, list<string>> headerFields;
    bytearray body;             // JSON Response bytes
};

// 5. HTTP REST Cycle Container UDR
internal Cycle {
    Request request;
    Response response;
};

// 6. Business Request UDRs (JSON Decoded)
internal ProductSearchRequest {
    string transactionId;
    string endUserId;
    string LOB;
    string city;
    string region;
    string contractorID;
    string purchaseType;
    string zoneId;
};

internal NewProductSimulateRequest {
    string transactionId;
    string endUserId;
    string salesOrg;
    string zoneId;
    string LOB;
    string currency;
    string city;
    string region;
    string contractId;
    string operation;
};

internal CurrentSubsRequest {
    string transactionId;
    list<string> bussinessPartner;
    list<string> contractId;
    list<string> contractorId;
    list<string> zone;
    list<string> city;
    list<any> currentSubscriptionSearchCriteria;
};

internal OfferListRequest {
    string transactionId;
    string LOB;
    string contractorID;
    string city;
    string region;
    string purchaseType;
};

// 7. Business Response UDRs
internal ProductSearchResponse {
    string transactionId;
    string status;
    string errorCode;
    string message;
    int totalCount;
};

internal OfferListResponse {
    string transactionId;
    string status;
    string errorCode;
    int totalOffers;
};

// 8. SAP SOM RFC UDR Definitions
internal ZSOM_PRODUCT_GET_DETAIL_API_UDR {
    drudr context;               // Holds the original Cycle UDR for async HTTP return
    map<string, any> exportParams;
};

internal ZSOM_PRODUCT_SIMULATE_API_UDR {
    drudr context;
    map<string, any> exportParams;
};

internal ZSOM_SUBSCRIPTION_SEARCH_API_T_UDR {
    drudr context;
    map<string, any> exportParams;
};
